# DeepSeek（OpenAI 兼容）配置示例 — 复制为 .env 或在环境中 export，切勿提交真实 Key
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
AGENT_PUBLIC_BASE_URL=http://localhost:8000
AGENT_UPLOAD_DIR=./data/uploads

# 可选：多实例时打开 Redis。同时给爬虫缓存 L2 和会话（meta / 黑板 / ChatMemory）。
# 不配则进程内 Caffeine / ConcurrentHashMap，重启会丢多轮对话。
# AGENT_REDIS_ENABLED=true
# AGENT_REDIS_HOST=127.0.0.1
# AGENT_REDIS_PORT=6379
# AGENT_REDIS_DB=0
# AGENT_REDIS_PASSWORD=

# 腾讯云对象存储（私有桶，仅服务端使用；真实密钥只写 .env，不要提交）
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_REGION=ap-guangzhou
# COS_BUCKET=bullshit-1474009034
# COS_CACHE_MAX_BYTES=10737418240
# 软过期：基础 2 小时，再加最多 30 分钟随机抖动，避免同时重爬
# COS_REVALIDATE_TTL_SECONDS=7200
# COS_REVALIDATE_JITTER_SECONDS=1800
